generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum ProviderType {
  OPENAI_COMPATIBLE
  CLAUDE
  GEMINI
  GROK
  DOUBAO
  DEEPSEEK
  MODELSCOPE
  HUNYUAN
  QWEN
}

enum RoomType {
  SINGLE
  GROUP
}

enum RoomModelExecutionState {
  ACTIVE
  COOLDOWN
  HALF_OPEN
}

enum ConversationRoundStatus {
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

enum ConversationRoundStepStatus {
  PENDING
  RUNNING
  REPLIED
  FAILED
  SKIPPED
}

enum ConversationRoundEventType {
  ROUND_CREATED
  STEP_RUNNING
  STEP_REPLIED
  STEP_FAILED
  ROUND_COMPLETED
  ROUND_PARTIAL
  ROUND_FAILED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ModelTestStatus {
  SUCCESS
  ERROR
}

enum ProviderConnectionDiscoveryStrategy {
  AUTO_FETCH
  MANUAL_ONLY
  AUTO_FETCH_WITH_MANUAL_FALLBACK
}

enum ProviderConnectionCheckStatus {
  SUCCESS
  ERROR
}

enum DailySourceKind {
  RSS
  AIHOT
  GITHUB_RELEASES
  GITHUB_REPO_EVENTS
  HACKERNEWS
  REDDIT
  WEB_FEED
}

enum DailyStoryClusterStatus {
  PENDING
  SELECTED
  REJECTED
}

enum DailyIssueStatus {
  DRAFT
  PUBLISHED
  SKIPPED
}

enum DailyIssueCategory {
  HEADLINES
  MODEL_RELEASES
  DEV_ECOSYSTEM
  PRODUCT_UPDATES
  TECH_INSIGHTS
  RUMORS
}

enum DailyIssueItemCertainty {
  CONFIRMED
  WATCHLIST
  RUMOR
}

enum DailyRunType {
  SCAN
  PUBLISH
  BACKFILL
  REPUBLISH
  REBUILD_RSS
}

enum DailyRunStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum DailyRunStepStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
}

model DailyInterestProfile {
  id                String   @id @default(cuid())
  name              String   @unique
  includeKeywordsJson String? @map("include_keywords_json")
  excludeKeywordsJson String? @map("exclude_keywords_json")
  interestsText     String?  @map("interests_text")
  enabled           Boolean  @default(true)
  priority          Int      @default(100)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([enabled, priority])
  @@map("daily_interest_profiles")
}

model ModelConfig {
  id                 String                  @id @default(cuid())
  name               String                  @unique
  connectionId       String?                 @map("connection_id")
  provider           ProviderType
  baseUrl            String                  @map("base_url")
  modelName          String                  @map("model_name")
  avatarLabel        String                  @default("OA") @map("avatar_label")
  avatarColor        String                  @default("#10b981") @map("avatar_color")
  apiKey             String                  @map("api_key")
  defaultReplyLength Int                     @default(300) @map("default_reply_length")
  lastTestStatus     ModelTestStatus?        @map("last_test_status")
  lastTestMessage    String?                 @map("last_test_message")
  lastTestedAt       DateTime?               @map("last_tested_at")
  enabled            Boolean                 @default(true)
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")
  connection         ProviderConnection?     @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  roomModels         ChatRoomModel[]
  messages           Message[]
  roundSteps         ConversationRoundStep[]

  @@index([connectionId])
  @@map("model_configs")
}

model ProviderConnection {
  id                   String                              @id @default(cuid())
  name                 String                              @unique
  provider             ProviderType
  baseUrl              String                              @map("base_url")
  apiKey               String                              @map("api_key")
  discoveryStrategy    ProviderConnectionDiscoveryStrategy @default(AUTO_FETCH_WITH_MANUAL_FALLBACK) @map("discovery_strategy")
  enabled              Boolean                             @default(true)
  lastAuthStatus       ProviderConnectionCheckStatus?      @map("last_auth_status")
  lastAuthMessage      String?                             @map("last_auth_message")
  lastAuthCheckedAt    DateTime?                           @map("last_auth_checked_at")
  lastDiscoveryStatus  ProviderConnectionCheckStatus?      @map("last_discovery_status")
  lastDiscoveryMessage String?                             @map("last_discovery_message")
  lastDiscoveredAt     DateTime?                           @map("last_discovered_at")
  createdAt            DateTime                            @default(now()) @map("created_at")
  updatedAt            DateTime                            @updatedAt @map("updated_at")
  models               ModelConfig[]

  @@map("provider_connections")
}

model ChatRoom {
  id                  String                   @id @default(cuid())
  title               String
  type                RoomType
  nextMessageSequence Int                      @default(1) @map("next_message_sequence")
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")
  roomModels          ChatRoomModel[]
  messages            Message[]
  conversationRounds  ConversationRound[]
  roundEvents         ConversationRoundEvent[]

  @@map("chat_rooms")
}

model ChatRoomModel {
  id                      String                  @id @default(cuid())
  roomId                  String                  @map("room_id")
  modelId                 String                  @map("model_id")
  sortOrder               Int                     @map("sort_order")
  executionState          RoomModelExecutionState @default(ACTIVE) @map("execution_state")
  cooldownUntil           DateTime?               @map("cooldown_until")
  consecutiveFailureCount Int                     @default(0) @map("consecutive_failure_count")
  timeoutCount            Int                     @default(0) @map("timeout_count")
  lastFailureKind         String?                 @map("last_failure_kind")
  lastFailureMessage      String?                 @map("last_failure_message")
  lastFailureAt           DateTime?               @map("last_failure_at")
  lastSuccessAt           DateTime?               @map("last_success_at")
  lastRecoveryAt          DateTime?               @map("last_recovery_at")
  room                    ChatRoom                @relation(fields: [roomId], references: [id], onDelete: Cascade)
  model                   ModelConfig             @relation(fields: [modelId], references: [id], onDelete: Restrict)
  roundSteps              ConversationRoundStep[]

  @@unique([roomId, modelId])
  @@unique([roomId, sortOrder])
  @@index([modelId])
  @@map("chat_room_models")
}

model Message {
  id                        String                 @id @default(cuid())
  roomId                    String                 @map("room_id")
  sequence                  Int
  role                      MessageRole
  modelId                   String?                @map("model_id")
  content                   String
  replyDurationMs           Int?                   @map("reply_duration_ms")
  queueDurationMs           Int?                   @map("queue_duration_ms")
  providerRequestDurationMs Int?                   @map("provider_request_duration_ms")
  providerAttemptCount      Int?                   @map("provider_attempt_count")
  recoveryRequestDurationMs Int?                   @map("recovery_request_duration_ms")
  rewriteRequestDurationMs  Int?                   @map("rewrite_request_duration_ms")
  persistenceDurationMs     Int?                   @map("persistence_duration_ms")
  speakerName               String?                @map("speaker_name")
  speakerProvider           ProviderType?          @map("speaker_provider")
  speakerModelName          String?                @map("speaker_model_name")
  speakerAvatarLabel        String?                @map("speaker_avatar_label")
  speakerAvatarColor        String?                @map("speaker_avatar_color")
  createdAt                 DateTime               @default(now()) @map("created_at")
  room                      ChatRoom               @relation(fields: [roomId], references: [id], onDelete: Cascade)
  model                     ModelConfig?           @relation(fields: [modelId], references: [id], onDelete: SetNull)
  userConversationRound     ConversationRound?     @relation("UserConversationRound")
  roundStep                 ConversationRoundStep? @relation("ConversationRoundStepMessage")

  @@unique([roomId, sequence])
  @@index([roomId, createdAt])
  @@index([modelId])
  @@map("messages")
}

model ConversationRound {
  id                  String                   @id @default(cuid())
  roomId              String                   @map("room_id")
  userMessageId       String                   @unique @map("user_message_id")
  userMessageSequence Int                      @map("user_message_sequence")
  status              ConversationRoundStatus  @default(RUNNING)
  startedAt           DateTime                 @default(now()) @map("started_at")
  finishedAt          DateTime?                @map("finished_at")
  room                ChatRoom                 @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userMessage         Message                  @relation("UserConversationRound", fields: [userMessageId], references: [id], onDelete: Cascade)
  steps               ConversationRoundStep[]
  events              ConversationRoundEvent[]

  @@index([roomId, startedAt])
  @@map("conversation_rounds")
}

model ConversationRoundStep {
  id           String                      @id @default(cuid())
  roundId      String                      @map("round_id")
  roomModelId  String                      @map("room_model_id")
  modelId      String                      @map("model_id")
  sortOrder    Int                         @map("sort_order")
  status       ConversationRoundStepStatus @default(PENDING)
  errorKind    String?                     @map("error_kind")
  errorMessage String?                     @map("error_message")
  startedAt    DateTime?                   @map("started_at")
  finishedAt   DateTime?                   @map("finished_at")
  messageId    String?                     @unique @map("message_id")
  round        ConversationRound           @relation(fields: [roundId], references: [id], onDelete: Cascade)
  roomModel    ChatRoomModel               @relation(fields: [roomModelId], references: [id], onDelete: Cascade)
  model        ModelConfig                 @relation(fields: [modelId], references: [id], onDelete: Restrict)
  message      Message?                    @relation("ConversationRoundStepMessage", fields: [messageId], references: [id], onDelete: SetNull)
  events       ConversationRoundEvent[]

  @@unique([roundId, roomModelId])
  @@unique([roundId, sortOrder])
  @@index([modelId])
  @@map("conversation_round_steps")
}

model ConversationRoundEvent {
  streamIndex  Int                          @id @default(autoincrement()) @map("stream_index")
  roomId       String                       @map("room_id")
  roundId      String                       @map("round_id")
  stepId       String?                      @map("step_id")
  roomModelId  String?                      @map("room_model_id")
  modelId      String?                      @map("model_id")
  eventType    ConversationRoundEventType   @map("event_type")
  roundStatus  ConversationRoundStatus?     @map("round_status")
  stepStatus   ConversationRoundStepStatus? @map("step_status")
  messageId    String?                      @map("message_id")
  errorKind    String?                      @map("error_kind")
  errorMessage String?                      @map("error_message")
  occurredAt   DateTime                     @default(now()) @map("occurred_at")
  room         ChatRoom                     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  round        ConversationRound            @relation(fields: [roundId], references: [id], onDelete: Cascade)
  step         ConversationRoundStep?       @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([roomId, streamIndex])
  @@index([roundId, occurredAt])
  @@map("conversation_round_events")
}

model DailySource {
  id            String            @id @default(cuid())
  name          String            @unique
  kind          DailySourceKind
  baseUrl       String?           @map("base_url")
  feedUrl       String?           @map("feed_url")
  configJson    String?           @map("config_json")
  enabled       Boolean           @default(true)
  priority      Int               @default(100)
  lastFetchedAt DateTime?         @map("last_fetched_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  items         DailySourceItem[]

  @@index([enabled, priority])
  @@map("daily_sources")
}

model DailySourceItem {
  id                String                  @id @default(cuid())
  sourceId          String                  @map("source_id")
  sourceItemKey     String                  @unique @map("source_item_key")
  externalId        String?                 @map("external_id")
  canonicalUrl      String                  @map("canonical_url")
  title             String
  author            String?
  publishedAt       DateTime?               @map("published_at")
  fetchedAt         DateTime                @default(now()) @map("fetched_at")
  language          String?
  contentText       String?                 @map("content_text")
  contentHtml       String?                 @map("content_html")
  summaryRaw        String?                 @map("summary_raw")
  metaJson          String?                 @map("meta_json")
  contentHash       String?                 @map("content_hash")
  source            DailySource             @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  clusterLinks      DailyStoryClusterItem[]
  primaryForCluster DailyStoryCluster[]     @relation("PrimaryClusterSourceItem")

  @@index([sourceId, publishedAt])
  @@index([canonicalUrl])
  @@index([contentHash])
  @@map("daily_source_items")
}

model DailyStoryCluster {
  id                  String                  @id @default(cuid())
  clusterKey          String                  @unique @map("cluster_key")
  canonicalUrl        String                  @map("canonical_url")
  primarySourceItemId String?                 @map("primary_source_item_id")
  title               String
  publishedAt         DateTime?               @map("published_at")
  score               Float?
  status              DailyStoryClusterStatus @default(PENDING)
  tagsJson            String?                 @map("tags_json")
  summaryDraft        String?                 @map("summary_draft")
  editorialReason     String?                 @map("editorial_reason")
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")
  primarySourceItem   DailySourceItem?        @relation("PrimaryClusterSourceItem", fields: [primarySourceItemId], references: [id], onDelete: SetNull)
  items               DailyStoryClusterItem[]
  issueItems          DailyIssueItem[]

  @@index([status, publishedAt])
  @@index([score])
  @@map("daily_story_clusters")
}

model DailyStoryClusterItem {
  id           String            @id @default(cuid())
  clusterId    String            @map("cluster_id")
  sourceItemId String            @map("source_item_id")
  isPrimary    Boolean           @default(false) @map("is_primary")
  sortOrder    Int               @default(1) @map("sort_order")
  createdAt    DateTime          @default(now()) @map("created_at")
  cluster      DailyStoryCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  sourceItem   DailySourceItem   @relation(fields: [sourceItemId], references: [id], onDelete: Cascade)

  @@unique([clusterId, sourceItemId])
  @@unique([clusterId, sortOrder])
  @@index([sourceItemId])
  @@map("daily_story_cluster_items")
}

model DailyIssue {
  id                String           @id @default(cuid())
  issueDate         String           @unique @map("issue_date")
  slug              String           @unique
  title             String
  summary           String?
  coverImageUrl     String?          @map("cover_image_url")
  status            DailyIssueStatus @default(DRAFT)
  publishedAt       DateTime?        @map("published_at")
  sourceWindowStart DateTime?        @map("source_window_start")
  sourceWindowEnd   DateTime?        @map("source_window_end")
  metaJson          String?          @map("meta_json")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  items             DailyIssueItem[]

  @@index([status, publishedAt])
  @@map("daily_issues")
}

model DailyIssueItem {
  id         String            @id @default(cuid())
  issueId    String            @map("issue_id")
  clusterId  String            @map("cluster_id")
  category   DailyIssueCategory @default(TECH_INSIGHTS)
  certainty  DailyIssueItemCertainty @default(CONFIRMED)
  title      String
  summary    String?
  content    String
  sourceUrl  String            @map("source_url")
  sourceName String?           @map("source_name")
  tagsJson   String?           @map("tags_json")
  sortOrder  Int               @map("sort_order")
  isFeatured Boolean           @default(false) @map("is_featured")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")
  issue      DailyIssue        @relation(fields: [issueId], references: [id], onDelete: Cascade)
  cluster    DailyStoryCluster @relation(fields: [clusterId], references: [id], onDelete: Restrict)
  sources    DailyIssueItemSource[]

  @@unique([issueId, clusterId])
  @@unique([issueId, sortOrder])
  @@index([issueId, category, sortOrder])
  @@index([isFeatured, sortOrder])
  @@map("daily_issue_items")
}

model DailyIssueItemSource {
  id         String         @id @default(cuid())
  issueItemId String        @map("issue_item_id")
  url        String
  label      String?
  sourceName String?        @map("source_name")
  sortOrder  Int            @map("sort_order")
  createdAt  DateTime       @default(now()) @map("created_at")
  issueItem  DailyIssueItem @relation(fields: [issueItemId], references: [id], onDelete: Cascade)

  @@unique([issueItemId, sortOrder])
  @@unique([issueItemId, url])
  @@index([sourceName])
  @@map("daily_issue_item_sources")
}

model DailyMajorEvent {
  id              String   @id @default(cuid())
  eventDate       String   @map("event_date")
  title           String
  summary         String
  category        String   @default("industry")
  sourceUrl       String   @map("source_url")
  sourceName      String?  @map("source_name")
  importanceScore Int      @default(80) @map("importance_score")
  tagsJson        String?  @map("tags_json")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([eventDate, title])
  @@index([eventDate])
  @@index([category, eventDate])
  @@index([importanceScore])
  @@map("daily_major_events")
}

model DailyRun {
  id           String         @id @default(cuid())
  runType      DailyRunType   @map("run_type")
  status       DailyRunStatus @default(RUNNING)
  startedAt    DateTime       @default(now()) @map("started_at")
  finishedAt   DateTime?      @map("finished_at")
  summary      String?
  errorMessage String?        @map("error_message")
  statsJson    String?        @map("stats_json")
  createdAt    DateTime       @default(now()) @map("created_at")
  steps        DailyRunStep[]

  @@index([runType, startedAt])
  @@index([status, startedAt])
  @@map("daily_runs")
}

model DailyRunStep {
  id          String             @id @default(cuid())
  runId       String             @map("run_id")
  stepName    String             @map("step_name")
  status      DailyRunStepStatus @default(PENDING)
  startedAt   DateTime?          @map("started_at")
  finishedAt  DateTime?          @map("finished_at")
  message     String?
  payloadJson String?            @map("payload_json")
  run         DailyRun           @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, startedAt])
  @@map("daily_run_steps")
}
