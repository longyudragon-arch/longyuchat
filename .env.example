# Database connection string.
# Local development can keep using SQLite:
DATABASE_URL="file:./prisma/dev.db"

# Disable dev-only mock provider routes on real servers.
ENABLE_DEV_MOCKS="false"
NEXT_PUBLIC_ENABLE_DEV_MOCKS="false"

# Recommended single-user app login. When enabled, pages redirect to /login
# instead of using the browser's Basic Auth dialog.
APP_LOGIN_ENABLED="false"
APP_LOGIN_USERNAME=""
APP_LOGIN_PASSWORD=""
APP_LOGIN_SESSION_SECRET=""
APP_LOGIN_SESSION_MAX_AGE_SECONDS="2592000"

# Optional fallback server access protection. When enabled, every page and API route
# requires Basic Auth except public static assets.
BASIC_AUTH_ENABLED="false"
BASIC_AUTH_USERNAME=""
BASIC_AUTH_PASSWORD=""

# Optional bearer token for unauthenticated health-check probes.
# When set, /api/health also accepts: Authorization: Bearer <token>
HEALTHCHECK_BEARER_TOKEN=""

# Strongly recommended in production. Use a 32-byte base64 key, for example:
# openssl rand -base64 32
MODEL_SECRET_ENCRYPTION_KEY=""

# Optional in-memory API rate limiting for sensitive POST endpoints.
# Defaults to enabled in production and disabled in development.
ENABLE_API_RATE_LIMITS="false"
API_RATE_LIMIT_WINDOW_SECONDS="60"
API_RATE_LIMIT_MAX_LOGIN_ATTEMPTS="5"
API_RATE_LIMIT_MAX_MESSAGE_POSTS="12"
API_RATE_LIMIT_MAX_MODEL_TESTS="10"
API_RATE_LIMIT_MAX_MODEL_DISCOVERY="20"

# File-based server error logging. Defaults to enabled in production.
ENABLE_FILE_LOGGING="false"
APP_LOG_DIR=""

# Optional escape hatch if you protect the app outside of Basic Auth.
ALLOW_UNPROTECTED_ACCESS_IN_PRODUCTION="false"

# Production startup listen host. Defaults to 127.0.0.1 when running start:prod.
# Set to 0.0.0.0 only when you intentionally want the Node process exposed directly.
APP_LISTEN_HOST=""

# SQLite backup settings for single-server deployments.
SQLITE_BACKUP_DIR=""
SQLITE_BACKUP_RETENTION_DAYS="7"

# AI Daily configuration. If AI_DAILY_MODEL_ID is empty, the worker falls back to the first enabled model.
AI_DAILY_ENABLED="true"
AI_DAILY_MODEL_ID=""
AI_DAILY_AUTOMATION_TOKEN=""
AI_DAILY_CANDIDATE_LIMIT="12"
AI_DAILY_PUBLISH_ITEM_LIMIT="6"
AI_DAILY_MINIMUM_ITEM_COUNT="3"
AI_DAILY_HEURISTIC_SCORE_THRESHOLD="4.5"
AI_DAILY_PUBLISH_WINDOW_HOURS="24"
AI_DAILY_FEED_BASE_URL=""
AI_DAILY_GENERATION_TIMEOUT_MS=""
AI_DAILY_TIMEZONE="Asia/Shanghai"
